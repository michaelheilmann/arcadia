// Canonical VPL text, version 1. This exact example is parsed by Arcadia.VPL.Tests.Text.
(module 1
  (types
    (type Void void)
    (type Color vector float 4))
  (uniforms)
  (vertex vertex_entry
    (interface
      (out position "position" Color -1 position))
    (functions
      (function vertex_entry "vertex_main" Void
        (parameters)
        (registers (register r0 Color))
        (block entry
          (construct r0 (float 1.0))
          (store (stage position) r0)
          (return)))))
  (fragment fragment_entry
    (interface
      (out color "color" Color 0 fragment_color))
    (functions
      (function fragment_entry "fragment_main" Void
        (parameters)
        (registers (register r0 Color))
        (block entry
          (construct r0 (float 1.0) (float 0.0) (float 0.0) (float 1.0))
          (store (stage color) r0)
          (return))))))
