}

enumeration Test.OtherColor {
  Red = 1
  Blue = 2
}

procedure bareReturn(variable early : Arcadia.Boolean) : Arcadia.Void {
  jumpIfTrue early done
  call $0 collect
done:
  return
}

procedure enumConstantRun : Test.Color {
  set $0 Test.Color.Red
  call $1 collect
  isEqualTo $2 $0 Test.OtherColor.Red
  jumpIfTrue $2 wrongIdentity
  isEqualTo $2 $0 Test.Color.Red
  jumpIfFalse $2 wrongIdentity
  isNotEqualTo $2 $0 Test.Color.Blue
  jumpIfFalse $2 wrongIdentity
  isEqualTo $2 $0 1
  jumpIfTrue $2 wrongIdentity
  construct $3 Test.Colored void Test.Color.Blue
  invoke $4 getColor $3
  return $4
wrongIdentity:
  raise
}

procedure nativeEnumConstant(variable maximum : Arcadia.Boolean) : Test.External.Kind {
  set $0 Test.External.UnsignedKind.First
  call $1 collect
  isEqualTo $2 $0 Test.External.UnsignedKind.First
  jumpIfFalse $2 wrongNativeConstant
  jumpIfTrue maximum maximumValue
  return Test.External.Kind.Second
maximumValue:
  return Test.External.Kind.Maximum
wrongNativeConstant:
  raise
}

procedure wrongEnumConstant : Test.Color {
  return Test.OtherColor.Red
}

