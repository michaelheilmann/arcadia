  set total 0
loop:
  isEqualTo $0 n 0
  jumpIfTrue $0 done
  add total total n
  subtract $1 n 1
  storeArgument $2 n $1
  jump loop
done:
  loadArgument $3 n
  add total total $3
  construct $4 Test.Native void total
  invoke $5 get $4
  return $5
}

