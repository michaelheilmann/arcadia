// Capability interface for UI objects that own an ordered child list.
//
// Child counts and indices are Natural64 in both PDL and C, not Size.
// Callers root receivers and managed arguments across stackless interface calls.
interface Arcadia.Engine.UI.Container {

  method getChildCount : Arcadia.Natural64

  method getChildAt(variable index : Arcadia.Natural64) : Arcadia.Object

  method addChild(variable child : Arcadia.Object) : Arcadia.Void

  method removeChild(variable child : Arcadia.Object) : Arcadia.Void

}
