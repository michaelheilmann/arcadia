/// Capability interface for UI objects that can own keyboard/controller focus.
/// Keep focus, blur and isFocused in the existing C dispatch order.
interface Arcadia.Engine.UI.Focusable {

  method focus : Arcadia.Void

  method blur : Arcadia.Void

  method isFocused : Arcadia.Boolean

}
