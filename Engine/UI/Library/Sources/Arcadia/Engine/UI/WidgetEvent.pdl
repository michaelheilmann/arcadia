/// Widget event initialized with a timestamp and source widget.
/// https://michaelheilmann.com/Arcadia/Engine/UI/#Arcadia_Engine_UI_WidgetEvent
abstract class Arcadia.Engine.UI.WidgetEvent extends Arcadia.Engine.UI.Event {
  /// The source of the event, or void when no source is supplied.
  variable source : Arcadia.Engine.UI.WidgetNode
  constructor(variable timestamp : Arcadia.Natural64, variable source : Arcadia.Engine.UI.WidgetNode) {
    construct $0 Arcadia.Engine.UI.Event self timestamp
    storeField self source source
  }
}
