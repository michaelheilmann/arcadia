// Capability interface for UI objects that expose an editable or selectable value.
//
// The current C contract uses `Arcadia_Value` by value so controls can expose scalar values without boxing them as objects.
// Preserve value tags and payloads; callers root managed values and receivers.
interface Arcadia.Engine.UI.ValueControl {

  method getValue : Arcadia.Value

  method setValue(variable value : Arcadia.Value) : Arcadia.Void

}
