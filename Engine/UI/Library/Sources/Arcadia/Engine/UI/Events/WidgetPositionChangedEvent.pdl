/// A widget position change, carrying the source and timestamp of WidgetEvent.
class "Arcadia/Engine/UI/Events/WidgetPositionChangedEvent.h" Arcadia.Engine.UI.WidgetPositionChangedEvent extends Arcadia.Engine.UI.WidgetEvent {
  variable horizontalPosition : Arcadia.Integer32
  variable verticalPosition : Arcadia.Integer32
  constructor(variable timestamp : Arcadia.Natural64, variable source : Arcadia.Engine.UI.WidgetNode, variable horizontalPosition : Arcadia.Integer32, variable verticalPosition : Arcadia.Integer32) {
    construct $0 Arcadia.Engine.UI.WidgetEvent self timestamp source
    storeField self horizontalPosition horizontalPosition
    storeField self verticalPosition verticalPosition
  }
}
