/// The base of all nodes, including audials and visuals nodes.
/// Resources represent nodes in terms of the audials and visuals backends.
/// Nodes manage backend resources using explicit reference counting. A backend
/// context owns strong references to its resources and retains their GC locks
/// until the resources are released by the context.
/// The base node stores no backend context. Derived nodes implement the context
/// setters; the base declarations have no default attach/detach implementation.
abstract class Arcadia.Engine.Node extends Arcadia.Object {
  /// Set the audials backend context; a null context detaches the current one.
  method abstract setAudialsBackendContext
    (
      variable backendContext : Arcadia.Engine.Audials.BackendContext
    ) : Arcadia.Void

  /// Set the visuals backend context; a null context detaches the current one.
  method abstract setVisualsBackendContext
    (
      variable backendContext : Arcadia.Engine.Visuals.BackendContext
    ) : Arcadia.Void
}
