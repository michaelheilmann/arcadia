// The implementation of a node factory for audials nodes. All three slots have
// bound native creation defaults; this is not an abstract factory or DSP port.
class Arcadia.Engine.Audials.NodeFactory extends Arcadia.Engine.NodeFactory {
  constructor() {}
  method native "Arcadia_Engine_Audials_NodeFactory_createSoundSourceNodeNative" createSoundSourceNode(variable backendContext : Arcadia.Engine.Audials.BackendContext, variable sampleBufferDefinition : Arcadia.ADL.SampleBufferDefinition) : Arcadia.Engine.Audials.SoundSourceNode
  method native "Arcadia_Engine_Audials_NodeFactory_createSoundSourceNodeFromDefinitionNative" createSoundSourceNodeFromDefinition(variable backendContext : Arcadia.Engine.Audials.BackendContext, variable definition : Arcadia.ADL.SoundSourceNodeDefinition) : Arcadia.Engine.Audials.SoundSourceNode
  method native "Arcadia_Engine_Audials_NodeFactory_createStreamingSoundSourceNodeFromDefinitionNative" createStreamingSoundSourceNodeFromDefinition(variable backendContext : Arcadia.Engine.Audials.BackendContext, variable definition : Arcadia.ADL.StreamingSoundSourceNodeDefinition) : Arcadia.Engine.Audials.StreamingSoundSourceNode
}
