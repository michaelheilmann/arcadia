/// Playback/update interface for an incrementally supplied sound source.
abstract class "Arcadia/Engine/Audials/Resources/StreamingSoundSourceResource.h" Arcadia.Engine.Audials.Implementation.StreamingSoundSourceResource extends Arcadia.Engine.Audials.Implementation.Resource {
  constructor(variable context : Arcadia.Engine.Audials.BackendContext) {
    construct $0 Arcadia.Engine.Audials.Implementation.Resource self context
  }
  method abstract isPlaying : Arcadia.Boolean
  method abstract play : Arcadia.Void
  method abstract pause : Arcadia.Void
  method abstract stop : Arcadia.Void
  method abstract setVolume(variable volume : Arcadia.Real32) : Arcadia.Void
  method abstract update : Arcadia.Void
}
