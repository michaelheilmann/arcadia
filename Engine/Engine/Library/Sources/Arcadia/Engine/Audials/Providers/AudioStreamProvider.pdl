/// Backend-neutral pull interface for incrementally generated mono audio.
abstract class "Arcadia/Engine/Audials/Providers/AudioStreamProvider.h" Arcadia.Engine.Audials.AudioStreamProvider extends Arcadia.Object {
  variable sampleRate : Arcadia.Natural32
  /// Render the next mono frames into the caller-sized DSP target. False
  /// indicates end-of-stream; report the number of frames written separately.
  method abstract read(variable target : Arcadia.Media.DSP.Buffer, variable numberOfFramesWritten : output reference Arcadia.Size) : Arcadia.Boolean
  method nonvirtual getSampleRate : Arcadia.Natural32 {
    loadField $0 self sampleRate
    return $0
  }
}
