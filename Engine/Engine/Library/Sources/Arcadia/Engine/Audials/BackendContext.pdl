/// The backend-neutral context for audio resource creation and master volume.
abstract class Arcadia.Engine.Audials.BackendContext extends Arcadia.Engine.BackendContext {
  method abstract createSoundSourceResource
    (
      variable sampleBuffer : Arcadia.Media.SampleBuffer
    ) : Arcadia.Engine.Audials.Implementation.SoundSourceResource

  method abstract createStreamingSoundSourceResource
    (
      variable provider : Arcadia.Engine.Audials.AudioStreamProvider
    ) : Arcadia.Engine.Audials.Implementation.StreamingSoundSourceResource

  /// The default implementation is intentionally a no-op. Backends may override it.
  method setMasterVolume
    (
      variable volume : Arcadia.Real64
    ) : Arcadia.Void {
  }
}
