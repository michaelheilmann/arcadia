/// A backend such as OpenGL or OpenAL, capable of creating backend contexts.
/// The engine provides a list of available backends. Backend contexts are
/// heavyweight objects that may occupy contested system resources such as
/// audio devices or video devices.
abstract class Arcadia.Engine.Backend extends Arcadia.Object {
  /// Get the name of this backend.
  method abstract getName : Arcadia.String

  /// Create a context providing access to the backend's system resources.
  /// @return A backend context providing access to the system.
  method abstract createBackendContext : Arcadia.Engine.BackendContext
}
