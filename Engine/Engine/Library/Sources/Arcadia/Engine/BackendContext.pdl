/// The base of audials and visuals backend contexts.
/// A backend context owns active backend resources; the engine tracks the active
/// context of each kind. Shut down an active context before creating a replacement.
/// Creating a context while one of the same kind is active is an error;
/// systems check the active-context references maintained by the engine.
/// For example, an OpenGL visuals context can be shut down before creating a
/// Vulkan visuals context.
abstract class Arcadia.Engine.BackendContext extends Arcadia.Object {
  /// Update this backend context.
  method abstract update : Arcadia.Void
}
