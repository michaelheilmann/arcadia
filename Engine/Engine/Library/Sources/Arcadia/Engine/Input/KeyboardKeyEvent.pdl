/// https://michaelheilmann.com/Arcadia/Engine/#Arcadia_Engine_Input_KeyboardKeyEvent
class Arcadia.Engine.Input.KeyboardKeyEvent extends Arcadia.Engine.Event {
  variable key : Arcadia.Engine.Input.KeyboardKey
  variable action : Arcadia.Engine.Input.KeyboardKeyAction

  /// Create a keyboard key event with its timestamp, action and native key.
  /// The action is Pressed or Released; KeyboardKey retains its native values,
  /// aliases and descriptions from KeyboardKey.i.
  constructor(variable timestamp : Arcadia.Natural64, variable action : Arcadia.Engine.Input.KeyboardKeyAction, variable key : Arcadia.Engine.Input.KeyboardKey) {
    construct $0 Arcadia.Engine.Event self timestamp
    storeField self action action
    storeField self key key
  }

  method nonvirtual getAction : Arcadia.Engine.Input.KeyboardKeyAction {
    loadField $0 self action
    return $0
  }

  method nonvirtual getKey : Arcadia.Engine.Input.KeyboardKey {
    loadField $0 self key
    return $0
  }
}
