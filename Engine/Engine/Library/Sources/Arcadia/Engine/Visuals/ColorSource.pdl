/// Select where a visual obtains its color.
enumeration Arcadia.Engine.Visuals.ColorSource {
  /// One uniform color supplied by the mesh.
  Mesh = 0
  /// Interpolated colors supplied by individual vertices.
  Vertex = 1
  /// Colors sampled from a texture.
  Texture = 2
}
