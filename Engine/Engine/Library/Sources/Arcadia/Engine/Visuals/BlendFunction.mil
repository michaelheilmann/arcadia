// https://michaelheilmann.com/Arcadia/Engine/#Arcadia_Engine_Visuals_BlendFunction
enumeration Arcadia.Engine.Visuals.BlendFunction {

  // RGB := (0,0,0), ALPHA := (0)
  Zero = 0

  // RGB := (1,1,1), ALPHA := (1)
  One = 1
  
  // RGB := (Rs, Gs, Bs), ALPHA := (As)
  SourceColor = 2

  // RGB := (1,1,1) - (Rs, Gs, Bs), ALPHA := 1 - (As)
  OneMinusSourceColor = 3
  
  // RGB := (Rd, Gd, Bd), ALPHA := (Ad)
  DestinationColor = 4
  
  // RGB := (1,1,1) - (Rd, Gd, Bd), ALPHA := 1 - (Ad)
  OneMinusDestinationColor = 5
  
  // RGB := (As, As, As), ALPHA := (As)
  SourceAlpha = 6
  
  // RGB := (1,1,1) - (As, As, As), ALPHA := 1 - (As)
  OneMinusSourceAlpha = 7
  
  // RGB := (Ad, Ad, Ad), ALPHA := (Ad)
  DestinationAlpha = 8
  
  // RGB := (1,1,1) - (Ad, Ad, Ad), ALPHA := 1 - (Ad)
  OneMinusDestinationAlpha = 9

}