// https://michaelheilmann.com/Arcadia/Engine/#Arcadia_Engine_Visuals_DepthCompareFunction
enumeration Arcadia.Engine.Visuals.DepthCompareFunction {

  Always = 0

  Never = 1

  Equal = 2

  NotEqual = 3

  LessThan = 4

  LessThanOrEqualTo = 5

  GreaterThan = 6
  
  GreaterThanOrEqualTo = 7

}
