// Stateless program-resource base. State and lifetime operations are inherited
// from the existing native Resource implementation; backend overrides supply
// the inherited resource operations.
abstract class "Arcadia/Engine/Visuals/Resources/ProgramResource.h" Arcadia.Engine.Visuals.ProgramResource extends Arcadia.Engine.Visuals.Resource {
  constructor(variable context : Arcadia.Engine.Visuals.BackendContext) {
    construct $0 Arcadia.Engine.Visuals.Resource self context
  }
}
