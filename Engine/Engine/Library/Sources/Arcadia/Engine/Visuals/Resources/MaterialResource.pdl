// Scalar material state is backend-neutral. Texture/program ownership and GPU
// operations remain in the native backend subtype. Preserve the mapped header
// path and inherited, unbound Resource operations.
abstract class "Arcadia/Engine/Visuals/Resources/MaterialResource.h" Arcadia.Engine.Visuals.MaterialResource extends Arcadia.Engine.Visuals.Resource {
  variable blendEnabled : Arcadia.Boolean
  variable blendSourceFunction : Arcadia.Engine.Visuals.BlendFunction
  variable blendDestinationFunction : Arcadia.Engine.Visuals.BlendFunction
  variable ambientColorSource : Arcadia.Engine.Visuals.ColorSource

  constructor(
    variable context : Arcadia.Engine.Visuals.BackendContext,
    variable blendEnabled : Arcadia.Boolean,
    variable blendSourceFunction : Arcadia.Engine.Visuals.BlendFunction,
    variable blendDestinationFunction : Arcadia.Engine.Visuals.BlendFunction,
    variable ambientColorSource : Arcadia.Engine.Visuals.ColorSource
  ) {
    construct $0 Arcadia.Engine.Visuals.Resource self context
    storeField self blendEnabled blendEnabled
    storeField self blendSourceFunction blendSourceFunction
    storeField self blendDestinationFunction blendDestinationFunction
    storeField self ambientColorSource ambientColorSource
  }
}
