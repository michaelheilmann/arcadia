// Native definition: Arcadia/Engine/Visuals/Resources/ModelResource.h.
// Matrix references are GC-managed; retained resources follow the resource lifetime protocol.
native implementation "Arcadia/Engine/Visuals/Resources/ModelResource.h" class Arcadia.Engine.Visuals.ModelResource extends Arcadia.Engine.Visuals.Resource {
  constant LocalToWorldMatrixDirty : Arcadia.Integer32 = 1
  /// The dirty flags.
  variable dirty : Arcadia.Natural8
  /// The local-to-world matrix of the model. Default is the identity matrix.
  variable localToWorldMatrix : Arcadia.Math.Matrix4Real32
  /// Constant buffer with model-specific information.
  /// Currently this contains only the model-to-world matrix.
  variable constantBuffer : retained Arcadia.Engine.Visuals.ConstantBufferResource
  /// Constant buffer with mesh-specific information.
  /// Currently this contains only the mesh color.
  variable meshConstantBuffer : retained Arcadia.Engine.Visuals.ConstantBufferResource
  /// The vertices of the mesh.
  variable meshVertexBuffer : retained Arcadia.Engine.Visuals.VertexBufferResource
  /// The material of the model.
  variable material : retained Arcadia.Engine.Visuals.MaterialResource

  method native "Arcadia_Engine_Visuals_ModelResource_setLocalToWorldMatrix" setLocalToWorldMatrix(variable localToWorldMatrix : Arcadia.Math.Matrix4Real32) : Arcadia.Void
}
