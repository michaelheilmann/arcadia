/// A display device exposed by a visuals backend.
abstract class Arcadia.Engine.Visuals.DisplayDevice extends Arcadia.Object {
  method abstract getCurrentDisplayMode : Arcadia.Engine.Visuals.DisplayMode
  method abstract getAvailableDisplayModes : Arcadia.List
  /// Receive the left, top, right and bottom display coordinates.
  method abstract getBounds(variable left : output reference Arcadia.Integer32, variable top : output reference Arcadia.Integer32, variable right : output reference Arcadia.Integer32, variable bottom : output reference Arcadia.Integer32) : Arcadia.Void
  /// The human-readable display name of the device.
  method abstract getName : Arcadia.String
  /// The unique identifier of this device.
  method abstract getId : Arcadia.String
}
