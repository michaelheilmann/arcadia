(module 1
  (types
    (type Z void)
    (type V3 vector float 3)
    (type V4 vector float 4)
    (type V2 vector float 2)
    (type M matrix 4 4)
    (type S sampler2D)
    (type Viewer record "Viewer" (field "viewToProjection" M) (field "worldToView" M))
    (type Model record "Model" (field "localToWorld" M))
    (type Mesh record "Mesh" (field "ambientColor" V4)))
  (uniforms
    (record viewer "viewer" Viewer)
    (record model "model" Model)
    (record mesh "mesh" Mesh)
    (scalar texture "ambientColorTexture" S))
  (vertex main
    (interface
      (in pos "vertexProgram_inputs_vertex_position" V3 0 none)
      (in color "vertexProgram_inputs_vertex_ambientColor" V4 1 none)
      (in uv "vertexProgram_inputs_vertex_ambientColorTextureCoordinate" V2 2 none)
      (out position "position" V4 -1 position)
      (out outUV "uv" V2 0 texcoord)
      (out outColor "ambientColor" V4 1 color))
    (functions
      (function main "vertex_main" Z
        (parameters)
        (registers
          (register r0 M) (register r1 M) (register r2 M)
          (register r3 M) (register r4 M) (register r5 V3)
          (register r6 V4) (register r7 V4) (register r8 V2) (register r9 V4))
        (block entry
          (load r0 (member_ref (uniform viewer) "viewToProjection"))
          (load r1 (member_ref (uniform viewer) "worldToView"))
          (load r2 (member_ref (uniform model) "localToWorld"))
          (multiply r3 r1 r2)
          (multiply r4 r0 r3)
          (load r5 (stage pos))
          (construct r6 r5 (float 1.0))
          (multiply r7 r4 r6)
          (store (stage position) r7)
          (load r8 (stage uv))
          (store (stage outUV) r8)
          (load r9 (stage color))
          (store (stage outColor) r9)
          (return)))))
  (fragment main
    (interface
      (in uv "uv" V2 0 texcoord)
      (in color "ambientColor" V4 1 color)
      (out pixel "fragmentColor" V4 0 fragment_color))
    (functions
      (function main "fragment_main" Z
        (parameters)
        (registers (register r0 V4) (register r1 V2) (register r2 S) (register r3 V4))
        (block entry
          (load r0 (stage color))
          (store (stage pixel) r0)
          (return))))))
