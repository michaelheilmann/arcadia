// https://michaelheilmann.com/Arcadia/Media/#Arcadia_Media_PixelFormat
enumeration Arcadia.Media.PixelFormat {
  AlphaBlueGreenRedNatural8 = 0
  AlphaGrayNatural8 = 1
  AlphaRedGreenBlueNatural8 = 2
  BlueGreenRedNatural8 = 3
  BlueGreenRedAlphaNatural8 = 4
  GrayNatural8 = 5
  GrayAlphaNatural8 = 6
  RedGreenBlueNatural8 = 7
  RedGreenBlueAlphaNatural8 = 8
}

// https://michaelheilmann.com/Arcadia/Media/#Arcadia_Media_PixelFormat_getNumberOfBytes
procedure Arcadia.Media.PixelFormat.getNumberOfBytes(variable self : Arcadia.Media.PixelFormat) : Arcadia.Size {
  isEqualTo $0 self Arcadia.Media.PixelFormat.AlphaBlueGreenRedNatural8
  jumpIfTrue $0 four
  isEqualTo $0 self Arcadia.Media.PixelFormat.AlphaGrayNatural8
  jumpIfTrue $0 two
  isEqualTo $0 self Arcadia.Media.PixelFormat.AlphaRedGreenBlueNatural8
  jumpIfTrue $0 four
  isEqualTo $0 self Arcadia.Media.PixelFormat.BlueGreenRedNatural8
  jumpIfTrue $0 three
  isEqualTo $0 self Arcadia.Media.PixelFormat.BlueGreenRedAlphaNatural8
  jumpIfTrue $0 four
  isEqualTo $0 self Arcadia.Media.PixelFormat.GrayNatural8
  jumpIfTrue $0 one
  isEqualTo $0 self Arcadia.Media.PixelFormat.GrayAlphaNatural8
  jumpIfTrue $0 two
  isEqualTo $0 self Arcadia.Media.PixelFormat.RedGreenBlueNatural8
  jumpIfTrue $0 three
  isEqualTo $0 self Arcadia.Media.PixelFormat.RedGreenBlueAlphaNatural8
  jumpIfTrue $0 four
  set $1 0
  jump finish
one:
  set $1 1
  jump finish
two:
  set $1 2
  jump finish
three:
  set $1 3
  jump finish
four:
  set $1 4
finish:
  call $2 Arcadia.Media.PixelFormat.checkedCount $1
  return $2
}

// https://michaelheilmann.com/Arcadia/Media/#Arcadia_Media_PixelFormat_getNumberComponents
// Every declared format uses one byte per component, including ABGR.
procedure Arcadia.Media.PixelFormat.getNumberOfComponents(variable self : Arcadia.Media.PixelFormat) : Arcadia.Size {
  call $1 Arcadia.Media.PixelFormat.getNumberOfBytes self
  return $1
}

// Size conversion and the original invalid-format error boundary only.
procedure native "Arcadia_Media_PixelFormat_checkedCountImpl" Arcadia.Media.PixelFormat.checkedCount(variable count : Arcadia.Natural64) : Arcadia.Size
