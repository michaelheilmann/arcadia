// Texture magnification and minification filters. Values correspond to the
// engine's texture filters. None selects the engine's default filter.
enumeration "Arcadia/ADL/Definitions/Visuals/TextureFilter.h" Arcadia.ADL.TextureFilter {
  // No filter is specified. This is the default value.
  None = 10
  // Linear filtering (e.g. bilinear interpolation).
  Linear = 0
  // Nearest-neighbor filtering.
  Nearest = 1
}
