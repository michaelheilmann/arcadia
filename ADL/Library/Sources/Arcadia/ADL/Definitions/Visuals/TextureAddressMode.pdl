// Texture address modes for the U and V texture coordinates. Values correspond
// to the engine's address modes. None selects the engine's default address mode.
enumeration "Arcadia/ADL/Definitions/Visuals/TextureAddressMode.h" Arcadia.ADL.TextureAddressMode {
  // No address mode is specified. This is the default value.
  None = 10
  // Texture coordinates are clamped to the border.
  ClampToBorder = 0
  // Texture coordinates are clamped to the edge.
  ClampToEdge = 1
  // Texture coordinates are mirrored and then repeated.
  MirroredRepeat = 2
  // Texture coordinates are repeated.
  Repeat = 3
}
