// Enumeration of blend functions. The values correspond to the engine's blend
// functions and OpenGL blend factors. None is the default: blending is disabled
// and no blend functions are applied. The native reader uses omitted properties
// for None; the literal asset string "None" is not accepted.
enumeration "Arcadia/ADL/Definitions/Visuals/BlendFunction.h" Arcadia.ADL.BlendFunction {
  None = 10
  Zero = 0
  One = 1
  SourceColor = 2
  OneMinusSourceColor = 3
  DestinationColor = 4
  OneMinusDestinationColor = 5
  SourceAlpha = 6
  OneMinusSourceAlpha = 7
  DestinationAlpha = 8
  OneMinusDestinationAlpha = 9
}
