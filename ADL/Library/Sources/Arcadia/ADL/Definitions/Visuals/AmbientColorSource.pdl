// Enumeration of ambient color sources. Preserve the ADL asset language's
// four choices independently of Engine.Visuals.ColorSource's three choices.
// The old header's AmbientSource example referred to this AmbientColorSource.
enumeration "Arcadia/ADL/Definitions/Visuals/AmbientColorSource.h" Arcadia.ADL.AmbientColorSource {
  Mesh = 0
  Vertex = 1
  Texture = 2
  TextureVertex = 3
}
