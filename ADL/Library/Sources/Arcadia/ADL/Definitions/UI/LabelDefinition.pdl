// A label definition. The three String properties are managed references;
// unlike the scalar properties, they must remain reachable through its visitor.
class "Arcadia/ADL/Definitions/UI/LabelDefinition.h" Arcadia.ADL.UI.LabelDefinition extends Arcadia.ADL.Definition {
  variable left : Arcadia.Integer32
  variable bottom : Arcadia.Integer32
  variable width : Arcadia.Natural32
  variable height : Arcadia.Natural32
  variable text : Arcadia.String
  variable horizontalAlignment : Arcadia.String
  variable verticalAlignment : Arcadia.String
  variable red : Arcadia.Natural8
  variable green : Arcadia.Natural8
  variable blue : Arcadia.Natural8
  variable alpha : Arcadia.Natural8
  variable pixelSize : Arcadia.Natural32

  constructor
    (
      variable definitions : Arcadia.ADL.Definitions,
      variable name : Arcadia.String,
      variable left : Arcadia.Integer32,
      variable bottom : Arcadia.Integer32,
      variable width : Arcadia.Natural32,
      variable height : Arcadia.Natural32,
      variable text : Arcadia.String,
      variable horizontalAlignment : Arcadia.String,
      variable verticalAlignment : Arcadia.String,
      variable red : Arcadia.Natural8,
      variable green : Arcadia.Natural8,
      variable blue : Arcadia.Natural8,
      variable alpha : Arcadia.Natural8,
      variable pixelSize : Arcadia.Natural32
    )
  {
    construct $0 Arcadia.ADL.Definition self definitions name
    storeField self left left
    storeField self bottom bottom
    storeField self width width
    storeField self height height
    call $1 Arcadia.ADL.UI.requireLabelString text
    storeField self text $1
    call $2 Arcadia.ADL.UI.requireLabelString horizontalAlignment
    storeField self horizontalAlignment $2
    call $3 Arcadia.ADL.UI.requireLabelString verticalAlignment
    storeField self verticalAlignment $3
    storeField self red red
    storeField self green green
    storeField self blue blue
    storeField self alpha alpha
    storeField self pixelSize pixelSize
  }
}

// Native Label construction rejects null String fields; the PDL reference
// representation otherwise permits void for an object-typed parameter.
procedure native "Arcadia_ADL_UI_requireLabelStringImpl" Arcadia.ADL.UI.requireLabelString(variable value : Arcadia.String) : Arcadia.String
