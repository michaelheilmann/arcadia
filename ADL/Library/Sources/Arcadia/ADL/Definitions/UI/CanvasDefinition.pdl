// A canvas definition. The native ContainerDefinition interface retains its
// descriptor and stackless call wrappers; children live in a managed List.
class "Arcadia/ADL/Definitions/UI/CanvasDefinition.h" Arcadia.ADL.UI.CanvasDefinition extends Arcadia.ADL.Definition implements Arcadia.ADL.UI.ContainerDefinition {
  variable width : Arcadia.Integer32
  variable height : Arcadia.Integer32
  variable childReferences : Arcadia.List

  constructor(variable definitions : Arcadia.ADL.Definitions, variable name : Arcadia.String, variable width : Arcadia.Integer32, variable height : Arcadia.Integer32) {
    construct $0 Arcadia.ADL.Definition self definitions name
    storeField self width width
    storeField self height height
    call $1 Arcadia.ADL.UI.createChildReferences
    storeField self childReferences $1
  }

  method getChildReferences : Arcadia.List {
    loadField $0 self childReferences
    return $0
  }
}

// Retain native ArrayList construction; Collections owns its storage and API.
procedure native "Arcadia_ADL_UI_createChildReferencesImpl" Arcadia.ADL.UI.createChildReferences : Arcadia.List
