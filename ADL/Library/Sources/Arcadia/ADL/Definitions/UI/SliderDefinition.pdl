// A slider definition. Bounds, value and step are stored without clamping.
class "Arcadia/ADL/Definitions/UI/SliderDefinition.h" Arcadia.ADL.UI.SliderDefinition extends Arcadia.ADL.Definition {
  variable left : Arcadia.Integer32
  variable bottom : Arcadia.Integer32
  variable width : Arcadia.Natural32
  variable height : Arcadia.Natural32
  variable minimum : Arcadia.Real64
  variable maximum : Arcadia.Real64
  variable value : Arcadia.Real64
  variable step : Arcadia.Real64

  constructor
    (
      variable definitions : Arcadia.ADL.Definitions,
      variable name : Arcadia.String,
      variable left : Arcadia.Integer32,
      variable bottom : Arcadia.Integer32,
      variable width : Arcadia.Natural32,
      variable height : Arcadia.Natural32,
      variable minimum : Arcadia.Real64,
      variable maximum : Arcadia.Real64,
      variable value : Arcadia.Real64,
      variable step : Arcadia.Real64
    )
  {
    construct $0 Arcadia.ADL.Definition self definitions name
    storeField self left left
    storeField self bottom bottom
    storeField self width width
    storeField self height height
    storeField self minimum minimum
    storeField self maximum maximum
    storeField self value value
    storeField self step step
  }
}
