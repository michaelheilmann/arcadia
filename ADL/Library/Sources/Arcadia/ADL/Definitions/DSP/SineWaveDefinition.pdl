// An asset definition for a sine wave of constant frequency in Hz:
// { type: "DSP.SineWave", name: "MyGame.MyDSPs.MySineWave", frequency: 220 }
// The actual native ABI uses Integer32, despite Natural32 in its old example.
class "Arcadia/ADL/Definitions/DSP/SineWaveDefinition.h" Arcadia.ADL.SineWaveDefinition extends Arcadia.ADL.Definition {
  variable frequency : Arcadia.Integer32
  constructor(variable definitions : Arcadia.ADL.Definitions, variable name : Arcadia.String, variable frequency : Arcadia.Integer32) {
    construct $0 Arcadia.ADL.Definition self definitions name
    storeField self frequency frequency
  }
  method link() : Arcadia.Void {}
  method nonvirtual getFrequency() : Arcadia.Integer32 {
    loadField $0 self frequency
    return $0
  }
}
