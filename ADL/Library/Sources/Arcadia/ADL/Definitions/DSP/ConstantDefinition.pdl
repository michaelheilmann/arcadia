// An asset definition for a DSP generating a constant signal:
// { type: "DSP.Constant", name: "MyGame.MyDSPs.MyConstant", value: 0.5 }
// Preserve exact Real32 storage; no normalization/clamping is introduced.
class "Arcadia/ADL/Definitions/DSP/ConstantDefinition.h" Arcadia.ADL.ConstantDefinition extends Arcadia.ADL.Definition {
  variable value : Arcadia.Real32
  constructor(variable definitions : Arcadia.ADL.Definitions, variable name : Arcadia.String, variable value : Arcadia.Real32) {
    construct $0 Arcadia.ADL.Definition self definitions name
    storeField self value value
  }
  method link() : Arcadia.Void {}
}
