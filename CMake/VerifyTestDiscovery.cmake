cmake_minimum_required(VERSION 3.29)
include("${CMAKE_CURRENT_LIST_DIR}/TestDiscoveryRuntime.cmake")
include("${MANIFEST}")
execute_process(COMMAND "${CTEST_COMMAND}" --test-dir "${BUILD_DIRECTORY}"
    -C "${CONFIGURATION}" --show-only=json-v1
  RESULT_VARIABLE status OUTPUT_VARIABLE json ERROR_VARIABLE error)
if(NOT "${status}" STREQUAL "0")
  message(FATAL_ERROR "Unable to read CTest registrations: ${error}")
endif()
string(JSON testCount LENGTH "${json}" tests)
math(EXPR lastTest "${testCount} - 1")
foreach(i RANGE 0 ${lastTest})
  string(JSON test GET "${json}" tests ${i})
  string(JSON name GET "${test}" name)
  string(SHA256 key "${name}")
  if(DEFINED test_${key})
    message(FATAL_ERROR "Duplicate CTest name: ${name}")
  endif()
  set(test_${key} ${i})
  set(testJson_${key} "${test}")
  string(JSON executable ERROR_VARIABLE commandError GET "${test}" command 0)
  if(NOT commandError)
    string(SHA256 executableKey "${executable}")
    list(APPEND executableTests_${executableKey} ${i})
  endif()
endforeach()
set(ARCADIA_DISCOVERY_METADATA_ONLY TRUE)
set(total 0)

function(Arcadia_checkTestProperty index property expected)
  string(JSON size LENGTH "${testJson}" properties)
  math(EXPR last "${size} - 1")
  foreach(i RANGE 0 ${last})
    string(JSON name GET "${testJson}" properties ${i} name)
    if("${name}" STREQUAL "${property}")
      string(JSON type TYPE "${testJson}" properties ${i} value)
      if(type STREQUAL "ARRAY")
        string(JSON count LENGTH "${testJson}" properties ${i} value)
        math(EXPR end "${count} - 1")
        set(actual)
        foreach(j RANGE 0 ${end})
          string(JSON value GET "${testJson}" properties ${i} value ${j})
          list(APPEND actual "${value}")
        endforeach()
      else()
        string(JSON actual GET "${testJson}" properties ${i} value)
      endif()
      if(type STREQUAL "BOOLEAN")
        if((actual AND expected) OR (NOT actual AND NOT expected))
          return()
        endif()
      elseif(type STREQUAL "NUMBER")
        # CTest serializes timeout seconds as 60.0 even when configured as 60.
        if(actual EQUAL expected)
          return()
        endif()
      elseif("${actual}" STREQUAL "${expected}")
        return()
      endif()
      message(FATAL_ERROR "Incorrect ${property} for test index ${index}: '${actual}' vs '${expected}'")
    endif()
  endforeach()
  # CTest omits false RUN_SERIAL values from JSON; absence means the default false.
  if(property STREQUAL "RUN_SERIAL" AND NOT expected)
    return()
  endif()
  message(FATAL_ERROR "Missing ${property} for test index ${index}")
endfunction()

foreach(path IN LISTS arcadiaMetadata)
  include("${path}")
  if(NOT EXISTS "${arcadiaExecutable}")
    message(FATAL_ERROR "Build ${arcadiaSuite} before checking discovery")
  endif()
  Arcadia_readCaseNames()
  string(SHA256 key "${arcadiaSuite}")
  if(DEFINED test_${key})
    message(FATAL_ERROR "Duplicate suite workload: ${arcadiaSuite}")
  endif()
  math(EXPR last "${arcadiaCount} - 1")
  foreach(i RANGE 0 ${last})
    set(name "${arcadiaSuite}.${arcadiaName_${i}}")
    string(SHA256 key "${name}")
    if(NOT DEFINED test_${key})
      message(FATAL_ERROR "Missing CTest case: ${name}")
    endif()
    set(index ${test_${key}})
    set(testJson "${testJson_${key}}")
    string(JSON command GET "${testJson}" command)
    string(JSON size LENGTH "${command}")
    list(LENGTH arcadiaArguments prefixCount)
    math(EXPR expectedSize "${prefixCount} + 3")
    if(NOT size EQUAL expectedSize)
      message(FATAL_ERROR "Wrong command length for ${name}")
    endif()
    string(JSON executable GET "${command}" 0)
    math(EXPR flagIndex "${size} - 2")
    math(EXPR nameIndex "${size} - 1")
    string(JSON flag GET "${command}" ${flagIndex})
    string(JSON selected GET "${command}" ${nameIndex})
    if(NOT "${executable}" STREQUAL "${arcadiaExecutable}" OR NOT "${flag}" STREQUAL "--case"
        OR NOT "${selected}" STREQUAL "${arcadiaName_${i}}")
      message(FATAL_ERROR "Wrong command for ${name}")
    endif()
    set(argumentIndex 1)
    foreach(argument IN LISTS arcadiaArguments)
      string(JSON actual GET "${command}" ${argumentIndex})
      if(NOT "${actual}" STREQUAL "${argument}")
        message(FATAL_ERROR "Wrong prefix argument for ${name}")
      endif()
      math(EXPR argumentIndex "${argumentIndex} + 1")
    endforeach()
    if(arcadiaIsolationRoot)
      string(JSON propertyCount LENGTH "${testJson}" properties)
      math(EXPR lastProperty "${propertyCount} - 1")
      set(directory "")
      foreach(propertyIndex RANGE 0 ${lastProperty})
        string(JSON property GET "${testJson}" properties ${propertyIndex} name)
        if(property STREQUAL "WORKING_DIRECTORY")
          string(JSON directory GET "${testJson}" properties ${propertyIndex} value)
        endif()
      endforeach()
      set(prefix "${arcadiaIsolationRoot}/${key}/run-")
      string(FIND "${directory}" "${prefix}" start)
      string(LENGTH "${prefix}" prefixLength)
      if(NOT start EQUAL 0 OR NOT IS_DIRECTORY "${directory}")
        message(FATAL_ERROR "Case does not have a private working directory: ${name}")
      endif()
      string(SUBSTRING "${directory}" ${prefixLength} -1 unique)
      string(LENGTH "${unique}" uniqueLength)
      if(NOT uniqueLength EQUAL 24 OR NOT unique MATCHES "^[0-9a-f]+$")
        message(FATAL_ERROR "Invalid case invocation identifier: ${name}")
      endif()
      if(DEFINED usedDirectory_${unique})
        message(FATAL_ERROR "Reused private working directory: ${directory}")
      endif()
      set(usedDirectory_${unique} TRUE)
    else()
      Arcadia_checkTestProperty(${index} WORKING_DIRECTORY "${arcadiaWorkingDirectory}")
    endif()
    if(arcadiaParallelSafe)
      Arcadia_checkTestProperty(${index} RUN_SERIAL FALSE)
    else()
      Arcadia_checkTestProperty(${index} RUN_SERIAL TRUE)
    endif()
    Arcadia_checkTestProperty(${index} LABELS "${arcadiaLabels}")
    Arcadia_checkTestProperty(${index} TIMEOUT "${arcadiaTimeout}")
    Arcadia_checkTestProperty(${index} SKIP_RETURN_CODE 77)
    set(environment "${arcadiaEnvironment}")
    if(arcadiaIsolationRoot)
      list(APPEND environment "TMP=${directory}" "TEMP=${directory}" "TMPDIR=${directory}")
    endif()
    if(environment)
      Arcadia_checkTestProperty(${index} ENVIRONMENT "${environment}")
    endif()
    list(LENGTH arcadiaProperties propertyCount)
    if(propertyCount GREATER 0)
      math(EXPR lastProperty "${propertyCount} - 1")
      foreach(propertyIndex RANGE 0 ${lastProperty} 2)
        math(EXPR valueIndex "${propertyIndex} + 1")
        list(GET arcadiaProperties ${propertyIndex} property)
        list(GET arcadiaProperties ${valueIndex} value)
        Arcadia_checkTestProperty(${index} "${property}" "${value}")
      endforeach()
    endif()
    set(matched_${index} TRUE)
    math(EXPR total "${total} + 1")
  endforeach()
  string(SHA256 executableKey "${arcadiaExecutable}")
  foreach(index IN LISTS executableTests_${executableKey})
    if(NOT DEFINED matched_${index})
      message(FATAL_ERROR "Unexpected CTest invocation of ${arcadiaSuite} at index ${index}")
    endif()
  endforeach()
endforeach()
message(STATUS "Verified ${total} discovered cases against CTest commands/properties; no missing names or duplicate suite runs")
