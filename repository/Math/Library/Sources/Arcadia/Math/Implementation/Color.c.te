#define ARCADIA_MATH_MODULE (1)
#include "Arcadia/Math/Implementation/Color@{numberOfComponents}@{componentSuffix}.h"

Arcadia_StaticAssert(@{minimumComponentValue} <= @{maximumComponentValue}, "minimum component value must be smaller than or equal to the maximum component value");

static void
Arcadia_Math_Color@{numberOfComponents}@{componentSuffix}_constructImpl
  (
    Arcadia_Thread* thread,
    Arcadia_Math_Color@{numberOfComponents}@{componentSuffix}* self
  );

static void
Arcadia_Math_Color@{numberOfComponents}@{componentSuffix}_initializeDispatchImpl
  (
    Arcadia_Thread* thread,
    Arcadia_Math_Color@{numberOfComponents}@{componentSuffix}Dispatch* self
  );

static void
Arcadia_Math_Color@{numberOfComponents}@{componentSuffix}_isEqualTo
  (
    Arcadia_Thread* thread
  );

static const Arcadia_ObjectType_Operations _objectTypeOperations = {
  Arcadia_ObjectType_Operations_Initializer,
  .construct = (Arcadia_Object_ConstructCallbackFunction*)&Arcadia_Math_Color@{numberOfComponents}@{componentSuffix}_constructImpl,
  .initializeDispatch = (Arcadia_ObjectDispatch_InitializeCallbackFunction*)&Arcadia_Math_Color@{numberOfComponents}@{componentSuffix}_initializeDispatchImpl,
};

static const Arcadia_Type_Operations _typeOperations = {
  Arcadia_Type_Operations_Initializer,
  .objectTypeOperations = &_objectTypeOperations,
};

Arcadia_defineObjectType(u8"Arcadia.Math.Color@{numberOfComponents}@{componentSuffix}", Arcadia_Math_Color@{numberOfComponents}@{componentSuffix},
                         u8"Arcadia.Object", Arcadia_Object,
                         &_typeOperations);

Arcadia_Math_Color@{numberOfComponents}@{componentSuffix}*
Arcadia_Math_Color@{numberOfComponents}@{componentSuffix}_create
  (
    Arcadia_Thread* thread
  )
{
  _Arcadia_BeginCreate(Arcadia_Math_Color@{numberOfComponents}@{componentSuffix});
  Arcadia_ValueStack_pushNatural8Value(thread, 0);
  _Arcadia_EndCreate(Arcadia_Math_Color@{numberOfComponents}@{componentSuffix});
}

Arcadia_Math_Color@{numberOfComponents}@{componentSuffix}*
Arcadia_Math_Color@{numberOfComponents}@{componentSuffix}_create4
  (
    Arcadia_Thread* thread,
    @{componentType} r,
    @{componentType} g,
    @{componentType} b,
    @{componentType} a
  )
{
  _Arcadia_BeginCreate(Arcadia_Math_Color@{numberOfComponents}@{componentSuffix});
  Arcadia_ValueStack_push@{componentSuffix}Value(thread, r);
  Arcadia_ValueStack_push@{componentSuffix}Value(thread, g);
  Arcadia_ValueStack_push@{componentSuffix}Value(thread, b);
  Arcadia_ValueStack_push@{componentSuffix}Value(thread, a);
  Arcadia_ValueStack_pushNatural8Value(thread, @{numberOfComponents});
  _Arcadia_EndCreate(Arcadia_Math_Color@{numberOfComponents}@{componentSuffix});
}

Arcadia_Math_Color@{numberOfComponents}@{componentSuffix}*
Arcadia_Math_Color@{numberOfComponents}@{componentSuffix}_create4v
  (
    Arcadia_Thread* thread,
    @{componentType} const* values
  )
{
  _Arcadia_BeginCreate(Arcadia_Math_Color@{numberOfComponents}@{componentSuffix});
  for (Arcadia_SizeValue i = 0, n = @{numberOfComponents}; i < n; ++i) {
    Arcadia_ValueStack_push@{componentSuffix}Value(thread, values[i]);
  }
  Arcadia_ValueStack_pushNatural8Value(thread, @{numberOfComponents});
  _Arcadia_EndCreate(Arcadia_Math_Color@{numberOfComponents}@{componentSuffix});
}

static void
Arcadia_Math_Color@{numberOfComponents}@{componentSuffix}_constructImpl
  (
    Arcadia_Thread* thread,
    Arcadia_Math_Color@{numberOfComponents}@{componentSuffix}* self
  )
{
  Arcadia_EnterConstructor(Arcadia_Math_Color@{numberOfComponents}@{componentSuffix});
  {
    Arcadia_ValueStack_pushNatural8Value(thread, 0);
    Arcadia_superTypeConstructor(thread, _type, self);
  }
  if (4 == _numberOfArguments) {
    for (Arcadia_SizeValue i = 0; i < @{numberOfComponents}; ++i) {
      self->components[i] = Arcadia_ValueStack_getReal32Value(thread, 4 - i);
    }  
  } else if (0 == _numberOfArguments) {
    for (Arcadia_SizeValue i = 0; i < @{numberOfComponents}; ++i) {
      self->components[i] = @{minimumComponentValue};
    }
  } else {
    Arcadia_Thread_setStatus(thread, Arcadia_Status_NumberOfArgumentsInvalid);
    Arcadia_Thread_jump(thread); 
  }
  Arcadia_LeaveConstructor(Arcadia_Math_Color@{numberOfComponents}@{componentSuffix});
}

static void
Arcadia_Math_Color@{numberOfComponents}@{componentSuffix}_initializeDispatchImpl
  (
    Arcadia_Thread* thread,
    Arcadia_Math_Color@{numberOfComponents}@{componentSuffix}Dispatch* self
  )
{
  ((Arcadia_ObjectDispatch*)self)->isEqualTo = &Arcadia_Math_Color@{numberOfComponents}@{componentSuffix}_isEqualTo;
}

static void
Arcadia_Math_Color@{numberOfComponents}@{componentSuffix}_isEqualTo
  (
    Arcadia_Thread* thread
  )
{
  Arcadia_Natural8Value numberOfArguments = Arcadia_ValueStack_getNatural8Value(thread, 0);
  if (2 != numberOfArguments) {
    Arcadia_Thread_setStatus(thread, Arcadia_Status_NumberOfArgumentsInvalid);
    Arcadia_Thread_jump(thread);
  }
  Arcadia_Math_Color@{numberOfComponents}@{componentSuffix}* self = Arcadia_ValueStack_getObjectReferenceValueChecked(thread, 2, _Arcadia_Math_Color@{numberOfComponents}@{componentSuffix}_getType(thread));
  if (!Arcadia_ValueStack_isObjectReferenceValue(thread, 1)) {
    Arcadia_ValueStack_popValues(thread, 3);
    Arcadia_ValueStack_pushBooleanValue(thread, Arcadia_BooleanValue_False);
    return;
  }
  Arcadia_Object* otherObject = Arcadia_ValueStack_getObjectReferenceValue(thread, 1);
  if (!Arcadia_Object_isInstanceOf(thread, otherObject, _Arcadia_Math_Color@{numberOfComponents}@{componentSuffix}_getType(thread))) {
    Arcadia_ValueStack_popValues(thread, 3);
    Arcadia_ValueStack_pushBooleanValue(thread, Arcadia_BooleanValue_False);
    return;
  }
  Arcadia_Math_Color@{numberOfComponents}@{componentSuffix}* other = (Arcadia_Math_Color@{numberOfComponents}@{componentSuffix}*)otherObject;
  for (Arcadia_SizeValue i = 0, n = @{numberOfComponents}; i < n; ++i) {
    if (self->components[i] != other->components[i]) {
      Arcadia_ValueStack_popValues(thread, 3);
      Arcadia_ValueStack_pushBooleanValue(thread, Arcadia_BooleanValue_False);
      return;
    }
  }
  Arcadia_ValueStack_popValues(thread, 3);
  Arcadia_ValueStack_pushBooleanValue(thread, Arcadia_BooleanValue_True);
}

void
Arcadia_Math_Color@{numberOfComponents}@{componentSuffix}_assign
  (
    Arcadia_Thread* thread,
    Arcadia_Math_Color@{numberOfComponents}@{componentSuffix}* self,
    Arcadia_Math_Color@{numberOfComponents}@{componentSuffix}* other
  )
{
  if (self != other) {
    for (Arcadia_SizeValue i = 0; i < @{numberOfComponents}; ++i) {
      self->components[i] = other->components[i];
    }
  }
}

void
Arcadia_Math_Color@{numberOfComponents}@{componentSuffix}_invert
  (
    Arcadia_Thread* thread,
    Arcadia_Math_Color@{numberOfComponents}@{componentSuffix}* self,
    Arcadia_Math_Color@{numberOfComponents}@{componentSuffix}* other
  )
{
  for (Arcadia_SizeValue i = 0; i < @{numberOfComponents}; ++i) {
    self->components[i] = @{maximumComponentValue} - self->components[i];
  }
}

void
Arcadia_Math_Color@{numberOfComponents}@{componentSuffix}_add
  (
    Arcadia_Thread* thread,
    Arcadia_Math_Color@{numberOfComponents}@{componentSuffix}* self,
    Arcadia_Math_Color@{numberOfComponents}@{componentSuffix}* other
  )
{
  for (Arcadia_SizeValue i = 0; i < @{numberOfComponents}; ++i) {
    if (self->components[i] > @{maximumComponentValue}) {
      self->components[i] = @{maximumComponentValue};
    }
  }
}
