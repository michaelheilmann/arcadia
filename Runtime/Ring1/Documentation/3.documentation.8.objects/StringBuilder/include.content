<pre><code>Arcadia_StringBuilder*
Arcadia_StringBuilder_create
  (
    Arcadia_Thread* thread
  );</code></pre>
<p>Create an empty builder.</p>
</section>

<section class="cxx entity method">
<h1 id="Arcadia_StringBuilder_insertAt">Arcadia_StringBuilder_insertAt</h1>
<pre><code>void
Arcadia_StringBuilder_insertAt
  (
    Arcadia_Thread* thread,
    Arcadia_StringBuilder* self,
    Arcadia_SizeValue codePointIndex,
    Arcadia_Value value
  );</code></pre>
<p>Insert at a zero-based codepoint boundary, including the end. Accepts RuntimeUTF8String, RuntimeByteArray, ByteArrayBuilder, String and StringBuilder values.</p>
</section>

