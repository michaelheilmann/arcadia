<section class="cxx entity method">

  <h1 id="Arcadia_ByteArray_getSize">Arcadia_ByteArray_getSize</h1>

  <my-signature><code>
  Arcadia_SizeValue<br>
  Arcadia_ByteArray_getSize<br>
  &nbsp;&nbsp;(<br>
  &nbsp;&nbsp;&nbsp;&nbsp;Arcadia_Thread* thread,<br>
  &nbsp;&nbsp;&nbsp;&nbsp;Arcadia_ByteArray const* self<br>
  &nbsp;&nbsp;)
  </code></my-signature>

  <my-summary>
  Get the size of this Byte array.
  Remarks:
  The size of a Byte array is the number of Bytes in that Byte array.
  This is an alias of Arcadia_ByteArray_getNumberOfBytes.
  </my-summary>

  <section class="cxx parameters">
    <h1>Parameters</h1>
    <div>
      <div><a href="#">Arcadia_Thread</a>* thread</div>
      <div>A pointer to the <code>Arcadia_Thread</code> object.</div>
    </div>
    <div>
      <div>Arcadia_ByteArray* self</div>
      <div>A pointer to this Byte array.</div>
    </div>
  </section>

  <section class="cxx return-value">
    <h1>Return value</h1>
    <p>The size of this Byte array.</p>
  </section>

</section>
