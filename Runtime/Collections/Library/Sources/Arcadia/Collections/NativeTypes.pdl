// Defining-module ownership for shared opaque native collection types. Their
// storage, headers, constructors and executable implementations remain native.
native "Arcadia/Collections/Include.h" class Arcadia.Collection extends Arcadia.Object {
  method nonvirtual native "Arcadia_Collection_isEmpty" isEmpty : Arcadia.Boolean
}
native "Arcadia/Collections/Include.h" class Arcadia.List extends Arcadia.Collection {}
native "Arcadia/Collections/Include.h" class Arcadia.ArrayList extends Arcadia.List {}
native "Arcadia/Collections/Include.h" class Arcadia.ImmutableList extends Arcadia.List {}
native "Arcadia/Collections/Include.h" class Arcadia.Set extends Arcadia.Collection {}
native "Arcadia/Collections/Include.h" class Arcadia.HashSet extends Arcadia.Set {}
native "Arcadia/Collections/Include.h" class Arcadia.Deque extends Arcadia.Collection {
  method nonvirtual native "Arcadia_Deque_insertBack" insertBack(variable value : Arcadia.Value) : Arcadia.Void
  method nonvirtual native "Arcadia_Deque_getFront" getFront : Arcadia.Value
  method nonvirtual native "Arcadia_Deque_removeFront" removeFront : Arcadia.Void
}
native "Arcadia/Collections/Include.h" class Arcadia.ArrayDeque extends Arcadia.Deque {}
