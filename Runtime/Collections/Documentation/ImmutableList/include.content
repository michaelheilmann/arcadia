<section class="cxx entity object">
<h1 id="Arcadia_ImmutableList">ImmutableList</h1>
<p><code>Arcadia_ImmutableList</code> extends <code>Arcadia_List</code>.</p>
<p>An immutable list of <code>Arcadia_Value</code> objects.</p>
</section>

<!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->

<section class="cxx entity method">

  <h1 id="Arcadia_ImmutableList_create">Arcadia_ImmutableList_create</h1>

  <my-signature><code>
  Arcadia_ImmutableList*<br>
  Arcadia_ImmutableList_create<br>
  &nbsp;&nbsp;(<br>
  &nbsp;&nbsp;&nbsp;&nbsp;Arcadia_Thread* thread,<br>
  &nbsp;&nbsp;&nbsp;&nbsp;Arcadia_Value argument<br>
  &nbsp;&nbsp;)
  </code></my-signature>

  <my-summary>
  Create an immutable list.
  </my-summary>

  <section class="cxx parameters">
    <h1>Parameters</h1>
    <div>
      <div>Arcadia_Thread* thread</div>
      <div>A pointer to the <code>Arcadia_Thread</code> object.</div>
    </div>
    <div>
      <div>Arcadia_Value argument</div>
      <div>A list value.</div>
    </div>
  </section>

  <section class="cxx errors">
    <h1>Errors</h1>
    <div>
      <div>Arcadia_Status_AllocationFailed</div>
      <div>An allocation failed.</div>
    </div>
  </section>

  <section class="cxx return-value">
    <h1>Return value</h1>
    <p>A pointer to the <code>Arcadia_ImmutableList</code> object.</p>
  </section>

  <section class="cxx remarks">
    <h1>Remarks</h1>
    <p>The elements of the list value are added to the immutable list which is created.</p>
  </section>

</section>
